LLM_PROVIDER = openai # add your llm provider if their key is availble below

# rn you can add openai, gemini, openrouter

OPENAI_API_KEY = your_openai_api_key_here
GEMINI_API_KEY = your_gemini_api_key_here
OPENROUTER_API_KEY = your_openrouter_api_key_here

BRAVE_API_KEY=your_brave_api_key_here


SEARCH_PROVIDER=brave


TRACK=C
REQUEST_TIMEOUT_SECONDS=20
DOWNLOAD_TIMEOUT_SECONDS=30
MAX_DOWNLOAD_BYTES= 10* 1024 * 1024 # 10 MB
MAX_SOURCES_PER_RUN=10
MAX_CANDIDATES=3
MAX_INVESTIGATION_LOOPS=2

ALLOWED_SOURCE_CLASSES=issuer_report,regulatory_filing,official_announcement,news_lead